from transformers import AutoTokenizer
tokenizer = AutoTokenizer.from_pretrained("google/gemma-2b", use_auth_token=True)

from transformers import CLIPModel, AutoModelForCausalLM
import torch.nn as nn

class ImageToCodeModel(nn.Module):
    def __init__(self, vision_model_name="openai/clip-vit-base-patch32", language_model_name="google/gemma-2b"):
        super(ImageToCodeModel, self).__init__()
        self.vision_model = CLIPModel.from_pretrained(vision_model_name).vision_model
        self.vision_proj = nn.Linear(self.vision_model.config.hidden_size, 256)
        self.language_model = AutoModelForCausalLM.from_pretrained(language_model_name)
        self.prefix_length = 3
        self.prefix_mlp = nn.Sequential(
            nn.Linear(256, self.prefix_length * self.language_model.config.hidden_size),
            nn.Tanh()
        )

    def forward(self, pixel_values, input_ids, attention_mask=None, labels=None):
        vision_out = self.vision_model(pixel_values=pixel_values)
        image_emb = vision_out.last_hidden_state[:, 0, :]
        image_proj = self.vision_proj(image_emb)
        prefix = self.prefix_mlp(image_proj).view(-1, self.prefix_length, self.language_model.config.hidden_size)
        text_emb = self.language_model.model.embed_tokens(input_ids)
        full_emb = torch.cat((prefix, text_emb), dim=1)

        if attention_mask is not None:
            prefix_mask = torch.ones((attention_mask.size(0), self.prefix_length), dtype=attention_mask.dtype).to(attention_mask.device)
            attention_mask = torch.cat((prefix_mask, attention_mask), dim=1)

        return self.language_model(
            inputs_embeds=full_emb,
            attention_mask=attention_mask,
            labels=labels
        )

model = ImageToCodeModel()
model.language_model.gradient_checkpointing_enable()
train_dataset = AsymptoteMultimodalDataset(train, tokenizer, image_transform)
val_dataset = AsymptoteMultimodalDataset(val, tokenizer, image_transform)

from transformers import TrainingArguments, Trainer

training_args = TrainingArguments(
    output_dir="./gemma-image2code",
    per_device_train_batch_size=1,
    per_device_eval_batch_size=1,
    gradient_accumulation_steps=1,
    num_train_epochs=3,
    learning_rate=5e-5,
    warmup_steps=100,
    weight_decay=0.01,
    logging_dir="./logs",
    logging_steps=50,
    save_steps=500,
    save_total_limit=2,
    fp16=True
)

collator = DataCollatorWithImages(tokenizer)

trainer = Trainer(
    model=model,
    args=training_args,
    train_dataset=train_dataset,
    eval_dataset=val_dataset,
    tokenizer=tokenizer,
    data_collator=collator
)

import torch
torch.cuda.empty_cache()
trainer.train()
trainer.save_model("./gemma-image2code")
tokenizer.save_pretrained("./gemma-image2code")
